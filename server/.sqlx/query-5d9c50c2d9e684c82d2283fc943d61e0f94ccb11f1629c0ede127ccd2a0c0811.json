  "query": "SELECT m.id, m.tenant_id AS group_id, g.name AS group_name,\n                      m.content, m.parent_id AS reply_to, m.created_at, m.updated_at\n               FROM group_messages m\n               JOIN groups g ON g.id = m.tenant_id\n               WHERE m.user_id = $1\n               ORDER BY m.created_at",
