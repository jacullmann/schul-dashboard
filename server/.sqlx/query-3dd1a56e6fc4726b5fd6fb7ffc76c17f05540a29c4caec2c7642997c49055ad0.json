  "query": "SELECT p.id, p.credential, u.email, u.email_verified\n               FROM passkeys p\n               JOIN users u ON u.id = p.user_id\n               WHERE p.user_id = $1 AND p.credential_id = $2\n               FOR UPDATE OF p",
