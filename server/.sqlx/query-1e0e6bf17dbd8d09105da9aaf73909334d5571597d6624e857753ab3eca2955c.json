  "query": "SELECT s.tenant_id AS group_id, g.name AS group_name,\n                      s.last_group_visit_at, s.last_schedule_visit_at, s.last_messages_visit_at\n               FROM user_tenant_state s\n               JOIN groups g ON g.id = s.tenant_id\n               WHERE s.user_id = $1\n               ORDER BY g.name",
