  "query": "SELECT ur.id, r.name as role_name, ur.user_id = g.owner_id AS \"is_owner!\"\n               FROM user_roles ur\n               JOIN roles r ON r.id = ur.role_id\n               JOIN groups g ON g.id = ur.tenant_id\n               WHERE ur.user_id = $1 AND ur.tenant_id = $2",
