  "query": "SELECT s.day, s.slot, s.course_id, s.is_dalton,\n                      sub.name AS \"subject?\", g.name AS group_name\n               FROM schedules s\n               JOIN groups g ON g.id = s.tenant_id\n               LEFT JOIN subjects sub ON sub.id = s.subject_id\n               WHERE s.id = $1 AND s.tenant_id = $2",
